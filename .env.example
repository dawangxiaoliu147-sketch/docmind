# ── 数据库 ────────────────────────────────────────────────
# 与 docker-compose.yml 中的配置保持一致
DATABASE_URL="postgresql://docmind:docmind@localhost:5432/docmind?schema=public"

# ── 认证 ──────────────────────────────────────────────────
# 生成方式：openssl rand -base64 32  （必须替换成你自己的随机值）
AUTH_SECRET="please-generate-a-random-secret-of-at-least-32-bytes"

# 登录 Cookie 是否只在 HTTPS 下生效：
#   用 http://IP 访问（没上 HTTPS）→ 保持不设置（或注释掉），默认 HTTP 可用
#   上了 HTTPS 后 → 设为 true 更安全
# COOKIE_SECURE="true"

# ── 注册邀请码（分享网站时强烈建议开启）──────────────────
# 填上之后，注册页会出现「邀请码」输入框，填错不让注册。
# 不填 = 任何人打开链接都能注册，然后拿你的 AI Key 随便用（账单风险自担）。
INVITE_CODE="换成你想设的邀请码"

# ── 用量配额（详见 src/lib/guard.ts）──────────────────────
# AI 调用上限，防止有人写脚本刷爆你的账单。自己用不够就调大。
AI_HOURLY_LIMIT="80"
AI_DAILY_LIMIT="300"
# 全站总闸：所有用户加起来的每日上限（换账号也冲不破这条线）
AI_GLOBAL_DAILY_LIMIT="2000"
# 每个用户每小时的上传次数上限（防止塞满磁盘）
UPLOAD_HOURLY_LIMIT="60"

# 登录/注册不做频率限制（正常用户不会被"尝试次数过多"挡在门外）。
# 如果以后想加回来，改 src/lib/actions/auth.ts 即可，限流工具已备好。

# ── 管理员 ────────────────────────────────────────────────
# 填你的邮箱，登录后即可访问 /admin 管理后台
ADMIN_EMAIL="admin@example.com"

# ── 对话模型（OpenAI 兼容接口）────────────────────────────
# DeepSeek:    AI_BASE_URL=https://api.deepseek.com        CHAT_MODEL=deepseek-chat
# 硅基流动:    AI_BASE_URL=https://api.siliconflow.cn/v1   CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# 本地 Ollama: AI_BASE_URL=http://localhost:11434/v1       CHAT_MODEL=qwen2.5
AI_BASE_URL="https://api.deepseek.com"
AI_API_KEY="sk-your-api-key-here"
CHAT_MODEL="deepseek-chat"

# ── 视觉模型（识图：简历智能体上传图片时使用）──────────────
# DeepSeek: deepseek-v4-flash-vision-exp ｜ 不填则回退到 CHAT_MODEL
VISION_MODEL="deepseek-v4-flash-vision-exp"

# ── 嵌入模型（可独立配置，不填则复用上面的 AI_BASE_URL / AI_API_KEY）──
# 注意：DeepSeek 不提供 embedding 接口，必须另配一个支持 embedding 的供应商：
#   硅基流动:  EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1  EMBEDDING_MODEL=BAAI/bge-m3
#   Ollama:    EMBEDDING_BASE_URL=http://localhost:11434/v1       EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY="sk-your-embedding-api-key-here"
EMBEDDING_MODEL="BAAI/bge-m3"
# 向量统一对齐到该维度（不同嵌入模型输出维度不同，入库时会自动补零/截断）
EMBEDDING_DIM="1536"
