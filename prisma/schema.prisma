// DocMind 数据模型
// 说明：Chunk.embedding 使用 PostgreSQL 的 pgvector 扩展存储向量，
// Prisma 通过 Unsupported 类型透传，实际读写使用原生 SQL。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String          @map("password_hash")
  avatarUrl      String?         @map("avatar_url")
  role           String          @default("user") @map("role") // user | admin
  // 访问审批：pending 待审核 | approved 已通过 | rejected 已拒绝
  // 默认写 approved 是为了「老数据迁移后不被锁住」；新注册由代码显式写 pending
  status         String          @default("approved") @map("status")
  // 管理员打的「信任」标签：为 true 则免申请，始终可登录
  trusted        Boolean         @default(false) @map("trusted")
  // 注册时填的申请说明，供管理员审核时参考
  note           String?         @map("note")
  preferences    String?         @map("preferences") // JSON 字符串：AI 记住的用户偏好
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  knowledgeBases KnowledgeBase[]
  applications   Application[]

  @@index([status])
  @@map("users")
}

model KnowledgeBase {
  id          String     @id @default(cuid())
  name        String
  description String?
  coverImage  String?    @map("cover_image")
  color       String?    @map("color")
  shared      Boolean    @default(false) @map("shared")
  userId      String     @map("user_id")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  conversations Conversation[]
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([userId])
  @@map("knowledge_bases")
}

model Document {
  id         String        @id @default(cuid())
  kbId       String        @map("kb_id")
  kb         KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  title      String
  fileName   String        @map("file_name")
  mimeType   String        @map("mime_type")
  size       Int
  status     String        @default("processing") // processing | ready | failed
  chunkCount Int           @default(0) @map("chunk_count")
  tags       String[]      @default([]) @map("tags")
  createdAt  DateTime      @default(now()) @map("created_at")
  chunks     Chunk[]

  @@index([kbId])
  @@map("documents")
}

model Chunk {
  id         String   @id @default(cuid())
  docId      String   @map("doc_id")
  document   Document @relation(fields: [docId], references: [id], onDelete: Cascade)
  kbId       String   @map("kb_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([kbId])
  @@index([docId])
  @@map("chunks")
}

model Conversation {
  id        String        @id @default(cuid())
  kbId      String        @map("kb_id")
  kb        KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  title     String
  messages  Message[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([kbId, userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model Job {
  id           String   @id @default(cuid())
  title        String
  company      String
  location     String
  salary       String
  tags         String[]
  description  String
  requirements String[]
  createdAt    DateTime @default(now()) @map("created_at")

  // ── 真实来源（2026-10-11 新增：把"假职位库"换成可溯源的真实职位）──
  // v2ex | eleduck | csv | manual | demo（demo = 早期内置的 12 条示例，UI 默认不显示）
  source       String    @default("manual") @map("source")
  /** 源内唯一 id（如 V2EX 的 topic id）；(source, sourceId) 唯一 → 重复同步不会产生副本 */
  sourceId     String?   @map("source_id")
  /** 原帖地址，供人工核对与投递时打开 */
  url          String?   @map("url")
  /** 原帖发布时间（不是入库时间），用于新鲜度排序与过滤 */
  postedAt     DateTime? @map("posted_at")
  fetchedAt    DateTime  @default(now()) @map("fetched_at")
  /** 投递方式：email | link | wechat | unknown（国内现实中以 email 为主） */
  applyChannel String?   @map("apply_channel")
  applyEmail   String?   @map("apply_email")
  applyUrl     String?   @map("apply_url")
  /** 其他联系方式原文（微信 / TG 等），保留原样供人工使用 */
  contact      String?   @map("contact")
  /** 源里已下架/失效的标记；不物理删除，保留投递历史 */
  active       Boolean   @default(true) @map("active")

  @@unique([source, sourceId])
  @@index([source])
  @@index([postedAt])
  applications Application[]
  @@map("jobs")
}

/**
 * 投递记录：把"找工作"这件事真正闭环 —— 投了哪些、到哪一步、什么时候该跟进。
 *
 * 与 Job/User 都声明了真实外键（ON DELETE CASCADE），删岗位或删用户都不会留孤儿记录；
 * 这一点比 Conversation/Resume 那两个"只有 userId 列、没外键"的老表更规范。
 * resumeId 故意不加外键：简历是可替换的产物，删简历不该把投递历史一起删掉。
 */
model Application {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String    @map("job_id")
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /** 用哪份简历投的（Resume.id，可空；不加外键，见上面的说明） */
  resumeId     String?   @map("resume_id")
  /** 渠道：boss | zhilian | liepin | email | refer | other */
  channel      String    @default("other")
  /** 状态：draft 准备中 | sent 已投递 | viewed 已读 | replied 有回复 | interview 面试中 | offer 已录用 | rejected 未通过 | closed 已关闭 */
  status       String    @default("draft")
  appliedAt    DateTime? @map("applied_at")
  /** 下次跟进时间（界面上按它排"今天该跟进谁"） */
  nextFollowUp DateTime? @map("next_follow_up")
  /** 时间线：JSON 数组字符串 [{at, from, to, note}]，够用且不必再开一张表 */
  timeline     String    @default("[]")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // 同一个岗位对同一个人只记一条 —— 再投就更新状态，而不是插新行
  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([nextFollowUp])
  @@map("applications")
}

model Resume {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  html      String
  tpl       String   @default("ribbon")
  accent    String   @default("#1f4e79")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("resumes")
}
